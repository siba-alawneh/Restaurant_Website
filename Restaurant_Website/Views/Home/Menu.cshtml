@{
    Layout = "_Layout1";
}
<div class="breadcrumb-area bg-img ptb-80" style="background-image:url(/ClientTemplate/assets/img/banner/breath.jpg);">
    <div class="container">
        <div class="breadcrumb-content text-center">
            <h3>menu</h3>
            <ul>
                <li>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="active">menu page </li>
            </ul>
        </div>
    </div>
</div>
<div class="product-menu-area pt-100 pb-70 gray-bg">
    <div class="container">
        <div class="section-title text-center mb-50">
            <h2>Our Food Menu</h2>
            <p> Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim nostrud exercitation ullamco laboris nisi.</p>
        </div>
        <div class="menu-tab-wrap mb-50">
            <div class="menu-tab-list nav text-center">

                <!-- All -->
                <a class="active" href="#tab-all" data-bs-toggle="tab">
                    All Items
                </a>

                <!-- Categories -->
                @foreach (var category in Model.MasterCategoryMenu)
                {
                    <a href="#tab-category-@category.Id" data-bs-toggle="tab">
                        @category.MenuName
                    </a>
                }

            </div>
        </div>


        <div class="tab-content jump">

            <!-- ALL ITEMS -->
            <div id="tab-all" class="tab-pane active">
                <div class="row">

                    @foreach (var item in Model.MasterItemMenu)
                    {
                        if (item.IsActive)
                        {
                            <div class="col-lg-6">
                                <div class="single-menu-product mb-30">

                                    <div class="menu-product-img">
                                        <img alt="@item.Title"
                                             src="@item.ImageUrl">
                                    </div>

                                    <div class="menu-product-content">

                                        <div class="menu-title-price">

                                            <div class="menu-title">
                                                <h4>
                                                    @item.Title
                                                </h4>
                                            </div>

                                            <div class="menu-price">
                                                <span>$@item.Price</span>
                                            </div>

                                        </div>

                                        <p>
                                            @item.Breif
                                        </p>

                                    </div>

                                </div>
                            </div>
                        }
                    }

                </div>
            </div>


            <!-- CATEGORIES -->
            @foreach (var category in Model.MasterCategoryMenu)
            {
                <div id="tab-category-@category.Id" class="tab-pane">

                    <div class="row">

                        @foreach (var item in Model.MasterItemMenu)
                        {
                            if (item.IsActive && item.CategoryId == category.Id)
                            {
                                <div class="col-lg-6">
                                    <div class="single-menu-product mb-30">

                                        <div class="menu-product-img">
                                            <img alt="@item.Title"
                                                 src="@item.ImageUrl">
                                        </div>

                                        <div class="menu-product-content">

                                            <div class="menu-title-price">

                                                <div class="menu-title">
                                                    <h4>
                                                        @item.Title
                                                    </h4>
                                                </div>

                                                <div class="menu-price">
                                                    <span>$@item.Price</span>
                                                </div>

                                            </div>

                                            <p>
                                                @item.Breif
                                            </p>

                                        </div>

                                    </div>
                                </div>
                            }
                        }

                    </div>

                </div>
            }

        </div>

    </div>

</div>

<div class="brand-logo-area ptb-100">
    <div class="container">
        <div class="brand-logo-active owl-carousel">
            @foreach (var item in Model.MasterPartner)
            {
                <div class="single-brand-logo">
                    <img alt="" src="@item.LogoImageUrl" width="141" height="120">
                </div>
            }

            @* <div class="single-brand-logo">
                <img alt="" src="~/ClientTemplate/assets/img/brand-logo/2.png">
            </div>
            <div class="single-brand-logo">
                <img alt="" src="~/ClientTemplate/assets/img/brand-logo/3.png">
            </div>
            <div class="single-brand-logo">
                <img alt="" src="~/ClientTemplate/assets/img/brand-logo/4.png">
            </div>
            <div class="single-brand-logo">
                <img alt="" src="~/ClientTemplate/assets/img/brand-logo/5.png">
            </div>
            <div class="single-brand-logo">
                <img alt="" src="~/ClientTemplate/assets/img/brand-logo/2.png">
            </div> *@
        </div>
    </div>
</div>