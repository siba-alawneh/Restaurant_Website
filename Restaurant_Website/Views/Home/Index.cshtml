<div class="about-area ptb-95">
    <div class="container">
        <div class="row d-flex align-items-center">
            <div class="col-lg-6">
                <div class="about-content pr-30">
                    @Html.Raw(@Model.SystemSetting.WelcomeNoteTitle)
                    @* <h2>About Basmoti Restaurant </h2> *@
                    @* <h3> Basmoti ensures healthy environment. Make a short trip. </h3> *@
                    @Html.Raw(@Model.SystemSetting.WelcomeNoteBreif)
                    <div class="about-peragraph">
                        @Html.Raw(@Model.SystemSetting.WelcomeNoteDesc)
                        <div class="default-btn-style mt-35">
                            <a href="#">read more</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about-img">
                    <img alt="" src="@Model.SystemSetting.WelcomeNoteImageUrl">
                </div>
            </div>
        </div>
    </div>
</div>
