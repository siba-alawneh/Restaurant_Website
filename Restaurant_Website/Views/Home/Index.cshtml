<div class="offer-area gray-bg ptb-100 bg-img" style="background-image:url(@Model.MasterOffer.FirstOrDefault()?.ImageUrl)">
    <div class="container">
        <div class="row">
            <div class="xl-auto col-xl-5 ms-auto col-lg-6 col-md-12">
                <div class="offer-content">
                    @* <h5>Exclusive Offer -20% Off This Week</h5> *@
                    @Html.Raw(@Model.MasterOffer.FirstOrDefault()?.Title)
                    @Html.Raw(@Model.MasterOffer.FirstOrDefault()?.Breif)
                    @* <h2>Milk Vanilla Ice Cream</h2> *@
                    @Model.MasterOffer.FirstOrDefault()?.Desc
                    <div class="default-btn-style book-btn mt-35">
                        <a class="scroll-up" href="#book">Book Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

