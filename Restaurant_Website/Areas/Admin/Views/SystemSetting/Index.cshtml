@model Restaurant_Website.ViewModels.SystemSettingFullViewModel

@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css">
<link rel="stylesheet" href="~/AdminTemplate/assets/css/Custombootstrap.css" />

@if (!ViewBag.HasAnyRecord)
{
    <div class="row">
    <div class="col-md-4">
        <form asp-action="CreateOrUpdate" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" /> 
            <div class="form-group">
                <label asp-for="WelcomeNoteTitle" class="control-label"></label>
                <input asp-for="WelcomeNoteTitle" class="form-control" />
                <span asp-validation-for="WelcomeNoteTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WelcomeNoteBreif" class="control-label"></label>
                <input asp-for="WelcomeNoteBreif" class="form-control" />
                <span asp-validation-for="WelcomeNoteBreif" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WelcomeNoteDesc" class="control-label"></label>
                <input asp-for="WelcomeNoteDesc" class="form-control" />
                <span asp-validation-for="WelcomeNoteDesc" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Copyright" class="control-label"></label>
                <input asp-for="Copyright" class="form-control" />
                <span asp-validation-for="Copyright" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MapLocation" class="control-label"></label>
                <input asp-for="MapLocation" class="form-control" />
                <span asp-validation-for="MapLocation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LogoImageFile" class="control-label"></label>
                <input asp-for="LogoImageFile" class="form-control" />
                <span asp-validation-for="LogoImageFile" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LogoImageFile2" class="control-label"></label>
                <input asp-for="LogoImageFile2" class="form-control" />
                <span asp-validation-for="LogoImageFile2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageFile1" class="control-label"></label>
                <input asp-for="ImageFile1" class="form-control" />
                <span asp-validation-for="ImageFile1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageFile2" class="control-label"></label>
                <input asp-for="ImageFile2" class="form-control" />
                <span asp-validation-for="ImageFile2" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageFile3" class="control-label"></label>
                <input asp-for="ImageFile3" class="form-control" />
                <span asp-validation-for="ImageFile3" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageFile4" class="control-label"></label>
                <input asp-for="ImageFile4" class="form-control" />
                <span asp-validation-for="ImageFile4" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <input type="submit" value="Clear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
}

<div class="table-responsive">
    <table id="masterAboutTable" class="table table-editable table-nowrap align-middle table-edits">
        <thead>
            <tr>
                <th>
                    @* @Html.DisplayNameFor(model => model.WelcomeNoteTitle) *@
                    Title
                </th>
                <th>
                    @* @Html.DisplayNameFor(model => model.WelcomeNoteBreif) *@
                    Breif
                </th>
                <th>
                    @* @Html.DisplayNameFor(model => model.WelcomeNoteDesc) *@
                    Description
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Copyright)
                </th>
                <th>
                    @* @Html.DisplayNameFor(model => model.MapLocation) *@
                    Map Location
                </th>
                <th>
                    @* @Html.DisplayNameFor(model => model.LogoImageUrl) *@
                    Logo 1
                </th>
                <th>
                    @* @Html.DisplayNameFor(model => model.LogoImageUrl2) *@
                    Logo 2
                </th>
                <th>
                    @* @Html.DisplayNameFor(model => model.WelcomeNoteImageUrl) *@
                    Welcome Note Image 1
                </th>
                <th>
                    @* @Html.DisplayNameFor(model => model.WelcomeNoteImageUrl2) *@
                    Welcome Note Image 2
                </th>
                <th>
                    @* @Html.DisplayNameFor(model => model.WelcomeNoteImageUrl3) *@
                    Welcome Note Image 3
                </th>
                <th>
                    @* @Html.DisplayNameFor(model => model.WelcomeNoteImageUrl4) *@
                    Welcome Note Image 4
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IsActive)
                </th>
           
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model.List) {
            <tr>
               
                <td>
                    @Html.DisplayFor(modelItem => item.WelcomeNoteTitle)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.WelcomeNoteBreif)
                </td>
                <td>
                    @* @Html.DisplayFor(modelItem => item.WelcomeNoteDesc) *@
                    @if (item.WelcomeNoteDesc != null && item.WelcomeNoteDesc.Length > 30)
                    {
                        @item.WelcomeNoteDesc.Substring(0, 30)
                        <span>...</span>
                        <a href="#" class="showDescription" data-description="@item.WelcomeNoteDesc">Read More..</a>
                    }
                    else
                    {
                        @item.WelcomeNoteDesc
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Copyright)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MapLocation)
                </td>
                <td>
                    @* @Html.DisplayFor(modelItem => item.LogoImageUrl) *@
                    <a href="#" class="showImage" data-image="@item.LogoImageUrl">Show Logo</a>
                </td>
                <td>
                    @* @Html.DisplayFor(modelItem => item.LogoImageUrl2) *@
                    <a href="#" class="showImage" data-image="@item.LogoImageUrl2">Show Logo 2 </a>
                </td>
                <td>
                    @* @Html.DisplayFor(modelItem => item.WelcomeNoteImageUrl) *@
                    <a href="#" class="showImage" data-image="@item.WelcomeNoteImageUrl">Show Image</a>
                </td>
              
                <td>
                    @* @Html.DisplayFor(modelItem => item.WelcomeNoteImageUrl2) *@
                    <a href="#" class="showImage" data-image="@item.WelcomeNoteImageUrl2">Show Image</a>
                </td>
                <td>
                    @* @Html.DisplayFor(modelItem => item.WelcomeNoteImageUrl3) *@
                    <a href="#" class="showImage" data-image="@item.WelcomeNoteImageUrl3">Show Image</a>
                </td>
                <td>
                    @* @Html.DisplayFor(modelItem => item.WelcomeNoteImageUrl4) *@
                    <a href="#" class="showImage" data-image="@item.WelcomeNoteImageUrl4">Show Image</a>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsActive)
                </td>
            
                <td class="d-flex justify-content-end gap-2">

                    @* <a class="btn btn-warning btnEdit" data-id="@item.Id" data-title="@item.WelcomeNoteTitle" data-brief="@item.WelcomeNoteBreif" 
                    data-desc="@item.WelcomeNoteDesc" data-copyright="@item.Copyright" data-location="@item.MapLocation" >Edit</a> *@

                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" value="@item.Id" />
                        <button type="button" class="btn btn-danger btnDelete"> Delete </button>
                    </form>

                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" value="@item.Id" />
                        @if (item.IsActive)
                        {
                            <button type="button" class="btn btn-secondary btnChangeStatus"> DeActivate </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btnChangeStatus"> Activate </button>
                        }
                    </form>
                </td>
            </tr>
    }
        </tbody>
</table>
</div>

<div id="imagePopup" class="image-popup">

    <span class="image-close">&times;</span>
    <img id="popupImage" />

</div>

<div id="descriptionPopup" class="description-popup">
    <div class="description-box">

        <span class="close-button">&times;</span>

        <h4>Description</h4>

        <p id="fullDescription"></p>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            $(".btnEdit").click(function(){

                var Id =  $(this).data("id")
                var WelcomeNoteTitle =  $(this).data("title")
                var WelcomeNoteBreif =  $(this).data("brief")
                var WelcomeNoteDesc =  $(this).data("desc")
                var Copyright = $(this).data("copyright")
                var MapLocation = $(this).data("location")

                $("#Id").val(Id);
                $("#WelcomeNoteTitle").val(WelcomeNoteTitle);
                $("#WelcomeNoteBreif").val(WelcomeNoteBreif);
                $("#WelcomeNoteDesc").val(WelcomeNoteDesc);
                $("#Copyright").val(Copyright);
                $("#MapLocation").val(MapLocation);
            })


            $(".btnDelete").click(function(){

             Swal.fire({
              title: "Are you sure?",
              text: "You won't be able to revert this!",
              icon: "warning",
              showCancelButton: true,
              confirmButtonColor: "#3085d6",
              cancelButtonColor: "#d33",
              confirmButtonText: "Yes, delete it!"
            })
            .then((result) => {
                if (result.isConfirmed) {
                Swal.fire({
                title: "Deleted!",
                text: "Your file has been deleted.",
                icon: "success"
                });

                $(this).parent().submit();
                }
            });

          })


             $(".btnChangeStatus").click(function(){

             Swal.fire({
              title: "Are you sure?",
              text: "You won't be able to revert this!",
              icon: "warning",
              showCancelButton: true,
              confirmButtonColor: "#3085d6",
              cancelButtonColor: "#d33",
              confirmButtonText: "Yes, Change it!"
            })
            .then((result) => {
                if (result.isConfirmed) {
                Swal.fire({
                title: "Status Changed!",
                text: "Your Status has been changed.",
                icon: "success"
                });

                $(this).parent().submit();
                }
            });

          })


            // Show Image
            $(".showImage").click(function (e) {
                e.preventDefault();

                var image = $(this).data("image");

                $("#popupImage").attr("src", image);
                $("#imagePopup").show();
            });


            // Close Image
            $(".image-close").click(function () {
                $("#imagePopup").hide();
            });


            // Show Description
            $(".showDescription").click(function (e) {
                e.preventDefault();

                var description = $(this).data("description");

                $("#fullDescription").text(description);
                $("#descriptionPopup").show();
            });


            // Close Description
            $(".close-button").click(function () {
                $("#descriptionPopup").hide();
            });



        })


    </script>
}