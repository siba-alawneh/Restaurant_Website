@model Restaurant_Website.ViewModels.MasterContactUsInformationFullViewModel

@{
    ViewData["Title"] = "Index";
}

@* <h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p> *@
<link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css">
<link rel="stylesheet" href="~/AdminTemplate/assets/css/Custombootstrap.css" />

@if (!ViewBag.HasAnyRecord)
{
    <div class="row">
        <div class="col-md-4">
            <form asp-action="CreateOrUpdate">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="form-group">
                    <label asp-for="Desc" class="control-label"></label>
                    <input asp-for="Desc" class="form-control" />
                    <span asp-validation-for="Desc" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PhoneNumber1" class="control-label"></label>
                    <input asp-for="PhoneNumber1" class="form-control" />
                    <span asp-validation-for="PhoneNumber1" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PhoneNumber2" class="control-label"></label>
                    <input asp-for="PhoneNumber2" class="form-control" />
                    <span asp-validation-for="PhoneNumber2" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email1" class="control-label"></label>
                    <input asp-for="Email1" class="form-control" />
                    <span asp-validation-for="Email1" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email2" class="control-label"></label>
                    <input asp-for="Email2" class="form-control" />
                    <span asp-validation-for="Email2" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Location" class="control-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Address" class="control-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="form-group form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                    </label>
                </div>

                <div class=" mt-3 gap-2">
                    @* col-md-3 d-flex align-items-end justify-content-end *@
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <input type="reset" value="Clear" class="btn btn-warning" />

                </div>
            </form>
        </div>
    </div>
}


<div class="table-responsive">
    <table id="masterAboutTable" class="table table-editable table-nowrap align-middle table-edits">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Desc)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PhoneNumber1)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PhoneNumber2)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Email1)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Email2)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Location)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Address)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IsActive)
                </th>

                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model.List) {
            <tr>

                <td>
                    @if (item.Desc != null && item.Desc.Length > 30)
                    {
                        @item.Desc.Substring(0, 30)
                        <span>...</span>
                        <a href="#" class="showDescription" data-description="@item.Desc">Read More..</a>
                    }
                    else
                    {
                        @item.Desc
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber1)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber2)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email1)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email2)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsActive)
                </td>
           
                <td class="d-flex justify-content-end gap-2">

                    <a class="btn btn-warning btnEdit" data-id="@item.Id" data-desc="@item.Desc" data-phone1="@item.PhoneNumber1" data-phone2="@item.PhoneNumber2"
                           data-email1="@item.Email1" data-email2="@item.Email2" data-location="@item.Location" data-address="@item.Address">Edit</a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" value="@item.Id" />
                        <button type="button" class="btn btn-danger btnDelete"> Delete </button>
                    </form>

                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" value="@item.Id" />
                        @if (item.IsActive)
                        {
                            <button type="button" class="btn btn-secondary btnChangeStatus"> DeActivate </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btnChangeStatus"> Activate </button>
                        }
                    </form>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>

<div id="descriptionPopup" class="description-popup">
    <div class="description-box">

        <span class="close-button">&times;</span>

        <h4>Description</h4>

        <p id="fullDescription"></p>

    </div>

</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            $(".btnEdit").click(function(){

                var Id =  $(this).data("id")
                var Desc = $(this).data("desc")
                var PhoneNumber1 = $(this).data("phone1")
                var PhoneNumber2 = $(this).data("phone2")
                var Email1 = $(this).data("email1")
                var Email2 = $(this).data("email2")
                var Location = $(this).data("location")
                var Address = $(this).data("adderss")
                

                $("#Id").val(Id);
                $("#Desc").val(Desc);
                $("#PhoneNumber1").val(PhoneNumber1);
                $("#PhoneNumber2").val(PhoneNumber2);
                $("#Email1").val(Email1);
                $("#Email2").val(Email2);
                $("#Location").val(Location);
                $("#Address").val(Address);

            })


            $(".btnDelete").click(function(){

             Swal.fire({
              title: "Are you sure?",
              text: "You won't be able to revert this!",
              icon: "warning",
              showCancelButton: true,
              confirmButtonColor: "#3085d6",
              cancelButtonColor: "#d33",
              confirmButtonText: "Yes, delete it!"
            })
            .then((result) => {
                if (result.isConfirmed) {
                Swal.fire({
                title: "Deleted!",
                text: "Your file has been deleted.",
                icon: "success"
                });

                $(this).parent().submit();
                }
            });

          })


             $(".btnChangeStatus").click(function(){

             Swal.fire({
              title: "Are you sure?",
              text: "You won't be able to revert this!",
              icon: "warning",
              showCancelButton: true,
              confirmButtonColor: "#3085d6",
              cancelButtonColor: "#d33",
              confirmButtonText: "Yes, Change it!"
            })
            .then((result) => {
                if (result.isConfirmed) {
                Swal.fire({
                title: "Status Changed!",
                text: "Your Status has been changed.",
                icon: "success"
                });

                $(this).parent().submit();
                }
            });


          });

            // Show Description
            $(".showDescription").click(function (e) {
                e.preventDefault();

                var description = $(this).data("description");

                $("#fullDescription").text(description);
                $("#descriptionPopup").show();
            });


            // Close Description
            $(".close-button").click(function () {
                $("#descriptionPopup").hide();
            });
          });


    </script>
}
