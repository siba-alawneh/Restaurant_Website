@model Restaurant_Website.ViewModels.MasterAboutFullViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
@* @if(Model.Count()==0)
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}
 *@

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.min.css">
<link rel="stylesheet" href="~/AdminTemplate/assets/css/Custombootstrap.css" /> 

@if (!ViewBag.HasAnyRecord)
{
 <div class="row">
    <div class="col-md-4">
        <form asp-action="CreateOrUpdate" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id"/>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Brief" class="control-label"></label>
                <input asp-for="Brief" class="form-control" />
                <span asp-validation-for="Brief" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Desc" class="control-label"></label>
                <input asp-for="Desc" class="form-control" />
                <span asp-validation-for="Desc" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageFile" class="control-label"></label>
                <input asp-for="ImageFile" type="file" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
           @*  <div class="form-group">
                <label asp-for="MasterAboutUrl" class="control-label"></label>
                <input asp-for="MasterAboutUrl" class="form-control" />
                <span asp-validation-for="MasterAboutUrl" class="text-danger"></span>
            </div> *@
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>
           
            <div class=" mt-3 gap-2">
                <input type="submit" value="Save" class="btn btn-primary" />
                <input type="reset" value="Clear" class="btn btn-warning" />
            </div>

        </form>
    </div>
</div>
}

<div class="table-responsive">
    <table id="masterAboutTable" class="table table-editable table-nowrap align-middle table-edits">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Title)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Brief)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Desc)
                </th>
                <th>
                    @* @Html.DisplayNameFor(model => model.ImageFile) *@
                    Image
                </th>
               @*  <th>
                    @Html.DisplayNameFor(model => model.MasterAboutUrl)
                </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.IsActive)
                </th>
            
                <th class="text-center">
                    Actions
                </th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model.List) 
    {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Brief)
                </td>
                <td>
                    @* @Html.DisplayFor(modelItem => item.Desc) *@
                    @if (item.Desc != null && item.Desc.Length > 30)
                    {
                        @item.Desc.Substring(0, 30)
                        <span>...</span>
                        <a href="#" class="showDescription" data-description="@item.Desc">Read More..</a>
                    }
                    else
                    {
                        @item.Desc
                    }
                </td>
                <td>
                    @* @Html.DisplayFor(modelItem => item.ImageFile) *@
                    <a href="#" class="showImage" data-image="@item.ImageUrl">Show Image</a>
                </td>
               @*  <td>
                    @Html.DisplayFor(modelItem => item.MasterAboutUrl)
                </td> *@
                <td>
                    @Html.DisplayFor(modelItem => item.IsActive)
                </td>
          
                <td class="d-flex justify-content-end gap-2">

                    <a class="btn btn-warning btnEdit" data-id="@item.Id" data-title="@item.Title" data-brief="@item.Brief" data-desc="@item.Desc" >Edit</a>

                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" value="@item.Id" />
                        <button type="button" class="btn btn-danger btnDelete"> Delete </button>
                    </form>

                    <form asp-action="ChangeStatus" method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" value="@item.Id" />
                        @if (item.IsActive)
                        {
                            <button type="button" class="btn btn-secondary btnChangeStatus"> DeActivate </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btnChangeStatus"> Activate </button>
                        }
                    </form>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>

<div id="imagePopup" class="image-popup">

    <span class="image-close">&times;</span>
    <img id="popupImage" />

</div>

<div id="descriptionPopup" class="description-popup">
    <div class="description-box">

        <span class="close-button">&times;</span>

        <h4>Description</h4>

        <p id="fullDescription"></p>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            $(".btnEdit").click(function(){

                var Id =  $(this).data("id")
                var Title =  $(this).data("title")
                var Brief =  $(this).data("brief")
                var Desc =  $(this).data("desc")
                //var MasterAboutUrl =  $(this).data("masterabouturl")

                $("#Id").val(Id);
                $("#Title").val(Title);
                $("#Brief").val(Brief);
                $("#Desc").val(Desc);
                //$("#MasterAboutUrl").val(MasterAboutUrl);
            })


            $(".btnDelete").click(function(){

             Swal.fire({
              title: "Are you sure?",
              text: "You won't be able to revert this!",
              icon: "warning",
              showCancelButton: true,
              confirmButtonColor: "#3085d6",
              cancelButtonColor: "#d33",
              confirmButtonText: "Yes, delete it!"
            })
            .then((result) => {
                if (result.isConfirmed) {
                Swal.fire({
                title: "Deleted!",
                text: "Your file has been deleted.",
                icon: "success"
                });

                $(this).parent().submit();
                }
            });

          })


             $(".btnChangeStatus").click(function(){

             Swal.fire({
              title: "Are you sure?",
              text: "You won't be able to revert this!",
              icon: "warning",
              showCancelButton: true,
              confirmButtonColor: "#3085d6",
              cancelButtonColor: "#d33",
              confirmButtonText: "Yes, Change it!"
            })
            .then((result) => {
                if (result.isConfirmed) {
                Swal.fire({
                title: "Status Changed!",
                text: "Your Status has been changed.",
                icon: "success"
                });

                $(this).parent().submit();
                }
            });

          })


            // Show Image
            $(".showImage").click(function (e) {
                e.preventDefault();

                var image = $(this).data("image");

                $("#popupImage").attr("src", image);
                $("#imagePopup").show();
            });


            // Close Image
            $(".image-close").click(function () {
                $("#imagePopup").hide();
            });


            // Show Description
            $(".showDescription").click(function (e) {
                e.preventDefault();

                var description = $(this).data("description");

                $("#fullDescription").text(description);
                $("#descriptionPopup").show();
            });


            // Close Description
            $(".close-button").click(function () {
                $("#descriptionPopup").hide();
            });



        })

        // function FillEditForm(){
        // }

    </script>
}